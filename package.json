{
    "name": "dbrief",
    "private": true,
    "version": "0.0.1",
    "license": "Apache-2.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "tauri": "tauri",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "lint": "biome check . && tsc --noEmit && cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings",
        "format": "biome check --write . && cargo fmt --all",
        "db:setup": "sqlx database create && sqlx migrate run --source crates/dbrief-core/migrations"
    },
    "dependencies": {
        "@tauri-apps/api": "2.12.4",
        "@tauri-apps/plugin-os": "2.4.0",
        "lucide-react": "1.69.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@babel/core": "8.1.0",
        "@biomejs/biome": "2.6.5",
        "@rolldown/plugin-babel": "0.3.0",
        "@tauri-apps/cli": "2.12.4",
        "@types/node": "24.19.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.2.1",
        "babel-plugin-react-compiler": "1.0.0",
        "typescript": "7.0.2",
        "vite": "8.3.6",
        "vitest": "5.1.0"
    }
}
